# ============================================================
# AI Paper Weekly 环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿把真实密钥提交到仓库。
# ============================================================

# ---- 大模型（默认对接阿里云 MaaS token-plan 的 OpenAI 兼容接口）----
# 该端点的密钥格式为 sk-sp- 开头，与百炼 DashScope 的 sk-<32位十六进制> 不同，
# 两者不可混用，密钥和 base_url 必须来自同一个平台。
LLM_API_KEY=
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash
# 单次请求超时（秒）。推理模型较慢，建议给足。
LLM_TIMEOUT_SECONDS=300
# 失败重试次数（含首次之外的额外重试）
LLM_MAX_RETRIES=3
# 输出长度上限（token）。留空即用 32768。
# 重要：推理模型（如 deepseek-v4.1-flash）的思考过程同样占用这个额度，
# 设小了会出现「返回空内容」或 finish_reason=length 被截断。
# 注意这不是「上下文窗口」——上下文窗口由模型本身决定，无法通过参数调大。
# 填 none / default / 0 表示不传该参数，交给服务端决定。
LLM_MAX_TOKENS=32768

# 如需切换到其他 OpenAI 兼容服务，改上面三行即可（密钥必须同源），例如：
#   官方 OpenAI： LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
#   DeepSeek：    LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   百炼DashScope：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- OpenAlex（可选）----
# 填写邮箱后进入「礼貌池」，配额更稳定、限流概率更低。留空也能用。
OPENALEX_MAILTO=

# ---- Crossref（可选）----
# 期刊论文的发表状态以 Crossref（DOI 注册机构）的注册记录为准。
# 同样建议填邮箱进入礼貌池；留空时自动复用 OPENALEX_MAILTO。
CROSSREF_MAILTO=

# ---- 微信通知（可选，但云端定时跑强烈建议配）----
# 走 PushPlus 的微信公众号渠道：到 https://www.pushplus.plus 扫码登录拿到 token，
# 填进来即可。出稿成功、候选不足、运行失败都会推一条到微信。
# 该接口要求账号已实名认证。留空则静默跳过，不影响出稿。
PUSHPLUS_TOKEN=

# ---- 微信公众号草稿箱（可选）----
# 个人订阅号只能建草稿，不能自动群发（发布/群发接口适用范围为「仅认证」）。
# 三个都配好、并把 publishing.wechat.enabled 改成 true 后，程序会自动建草稿。
# 注意：调用来源 IP 必须在公众号后台的 IP 白名单内，否则返回 40164。
WECHAT_APPID=
WECHAT_APPSECRET=
# 封面图的本地路径（jpg/png）。微信要求图文消息必须带封面，
# 且必须是「永久素材」，程序会自动上传换取 thumb_media_id。
WECHAT_COVER_IMAGE=

# ---- 运行时参数（可选，命令行参数优先级更高）----
# 强制指定主题组：g_mon / g_wed / g_fri
RUN_GROUP=
LOG_LEVEL=INFO